# DabbaBox Tiffin CRM — environment template
# Copy to .env and adjust as needed

# Server
PORT=4000

# Auth — CHANGE THIS to any long random string in production
JWT_SECRET=change-me-to-a-long-random-secret-string

# Default admin credentials (created on first run, can be changed later)
ADMIN_EMAIL=admin@dabbabox.in
ADMIN_PASSWORD=dabbabox@2026

# WhatsApp webhook verification (used by Meta/Twilio when verifying your webhook URL)
WHATSAPP_VERIFY_TOKEN=dabbabox-verify-token-2026

# Twilio outbound (optional) — fill these to actually SEND WhatsApp replies.
# Without them, outbound messages are still recorded in the inbox but not delivered.
# Get from https://console.twilio.com → Account SID & Auth Token
# TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_TOKEN=your_auth_token
# TWILIO_FROM=whatsapp:+14155238886
